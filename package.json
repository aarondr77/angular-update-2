{
  "name": "trade-operations-console",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:api": "json-server --watch mock-api/db.json --port 3000 --routes mock-api/routes.json",
    "start:app": "ng serve --proxy-config proxy.conf.json",
    "start": "concurrently \"npm run start:api\" \"npm run start:app\"",
    "build": "ng build",
    "build:prod": "npx ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:visual": "cypress run --spec cypress/e2e/visual-regression.cy.ts",
    "ci": "npm run lint && npm run test && npm run build:prod"
  },
  "private": true,
  "engines": {
    "node": "16.20.2",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "15.2.9",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/flex-layout": "14.0.0-beta.41",
    "@angular/forms": "15.2.10",
    "@angular/material": "15.2.9",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "@bofa/legacy-trend-widget": "file:packages/legacy-trend-widget",
    "@ngrx/effects": "^15.4.0",
    "@ngrx/entity": "^15.4.0",
    "@ngrx/store": "^15.4.0",
    "@ngrx/store-devtools": "^15.4.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "15.2.11",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "15.2.11",
    "@angular/compiler-cli": "15.2.10",
    "@types/jest": "^28.1.8",
    "@types/node": "^16.18.0",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "axe-core": "^4.8.4",
    "concurrently": "^7.6.0",
    "cypress": "12.17.4",
    "cypress-image-snapshot": "4.0.1",
    "eslint": "8.28.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "28.1.3",
    "jest-axe": "8.0.0",
    "jest-environment-jsdom": "28.1.3",
    "jest-preset-angular": "12.2.6",
    "json-server": "0.17.4",
    "prettier": "^2.8.8",
    "typescript": "~4.9.5"
  }
}
